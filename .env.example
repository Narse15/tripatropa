# ─────────────────────────────────────────────────────────────
# TRIPATROP — environment variables
# Copy to .env.local (local) or add in Vercel → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# Public URL of the site, no trailing slash (used for Stripe redirects + email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database (PostgreSQL: Neon, Supabase, Vercel Postgres, Railway…) ──
DATABASE_URL=postgres://user:password@host:5432/tripatrop?sslmode=require

# ── Stripe (Dashboard → Developers → API keys / Webhooks) ──
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Amounts in cents (defaults: 4900 and 15000)
TRIPATROP_DEPOSIT_CENTS=4900
TRIPATROP_FINAL_CENTS=15000

# ── Transactional email (Resend: resend.com → API Keys; verify your domain first) ──
RESEND_API_KEY=re_xxx
TRIPATROP_FROM_EMAIL="TRIPATROP <hello@yourdomain.com>"

# ── Business details (never hard-coded) ──
TRIPATROP_OWNER_EMAIL=owner@yourdomain.com
TRIPATROP_SUPPORT_EMAIL=hello@yourdomain.com
TRIPATROP_PRIVACY_EMAIL=privacy@yourdomain.com
TRIPATROP_LEGAL_NAME="[LEGAL BUSINESS NAME]"
TRIPATROP_BUSINESS_ADDRESS="[BUSINESS ADDRESS]"
TRIPATROP_JURISDICTION="[JURISDICTION]"

# ── Admin (/admin) ──
ADMIN_PASSWORD=choose-a-long-password
# Random 32+ character string, e.g. `openssl rand -hex 32`
ADMIN_SESSION_SECRET=replace-with-random-hex

# Days before a $150 final-payment link expires (default 30)
FINAL_LINK_TTL_DAYS=30

# ── Social ──
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/
NEXT_PUBLIC_TIKTOK_URL=https://tiktok.com/

# ── Analytics (optional): "plausible" or "ga4" ──
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA4_ID=

# Show orange "OWNER TO CONFIRM" draft notes on FAQ/legal pages. Set to false after legal review.
NEXT_PUBLIC_SHOW_DRAFT_NOTES=true
